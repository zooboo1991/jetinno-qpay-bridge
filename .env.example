# Хуулж аваад .env болгоно. .env нь git-д ордоггүй (.gitignore).
# Локалд ажиллуулах: node --env-file=.env src/server.js

# --- QPay (merchant.qpay.mn-аас) ---
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# QPAY_BASE_URL=https://merchant.qpay.mn

# --- Jetinno (маягтыг бөглөж илгээсний дараа өгнө) ---
JETINNO_USERNAME=
JETINNO_APIKEY=

# --- Сервер ---
# Render дээр автоматаар RENDER_EXTERNAL_URL-ээс авах тул тохируулах шаардлагагүй.
# Локалд туннел (ngrok) хэрэглэж байвал л бичнэ.
# PUBLIC_URL=https://таны-домэйн
# PORT=3000

# --- Локал туршилт ---
# QPay-гүйгээр урсгалыг шалгах
# QPAY_MOCK=1

# --- Тохируулж болох зүйлс ---
# Jetinno цент-ээр илгээнэ гэж үзсэн. Бодит машины эхний getQrCode логийг
# хараад шаардлагатай бол 1 болгоно.
# AMOUNT_DIVISOR=100
# Төлөгдөөгүй QR хэдэн миллисекундын дараа цуцлагдах
# ABANDON_AFTER_MS=600000

# =====================================================================
# Доорхыг тохируулснаар олон эзэмшигчийн горим асна. Аль нэг нь дутвал
# тухайн боломж ЧИМЭЭГҮЙ унтарна — endpoint нь 404 буцаана, алдаа бичихгүй.
# Юу асаалттайг эхлэх логоос хар: "owner api mounted" / "send-sms hook mounted".
# =====================================================================

# --- Өгөгдлийн сан ---
# Энэ ганц хувьсагч дараах бүгдийг асаана: машин бүрийн мөнгө эзэмшигчийн
# данс руу чиглэх, restart-ын дараа төлбөр сэргээх, /owner/v1, /hooks.
# Supabase → Connect → Session pooler. Шууд холболт (5432) нь зөвхөн IPv6,
# Render нь IPv4 тул холбогдохгүй.
# DATABASE_URL=

# --- QPay нууц үг битүүмжлэх түлхүүрүүд ---
# scripts/add-owner.js ЭНЭ компьютер дээр битүүмжилдэг, Render дээрх сервер
# задалдаг — тиймээс хоёр тал ЯГ ИЖИЛ байх ёстой. Нэг тэмдэгт зөрвөл
# бүртгэлтэй машины борлуулалт бүр татгалзагдана.
# Үүсгэх: node -e "const c=require('crypto');console.log('CRED_KEYS=k1:'+c.randomBytes(32).toString('base64'));console.log('CRED_KEY_ACTIVE=k1');console.log('CRED_FP_KEY='+c.randomBytes(32).toString('base64'))"
# CRED_KEYS=k1:
# CRED_KEY_ACTIVE=k1
# CRED_FP_KEY=

# --- Эзэмшигчийн портал ---
# SUPABASE_URL нь /owner/v1-ийг асаана. PORTAL_ORIGIN нь браузерын Origin
# толгойтой яг тэнцүү байх ёстой — ташуу зураас, www нэмэгдвэл CORS хаагдана.
# SUPABASE_URL=https://<ref>.supabase.co
# PORTAL_ORIGIN=https://admin.coffeine.mn

# --- Нэвтрэх кодын SMS (Supabase → Skytel) ---
# Гурвуулаа байж л /hooks/send-sms үүснэ. SMS_PARAM_* нь Skytel-ийн хэлбэрээр
# өгөгдмөл; SMS_API_METHOD нь POST — гарцад TLS байхгүй тул кодыг URL-аас
# гаргах зорилготой.
# SEND_SMS_HOOK_SECRET=v1,whsec_...
# SMS_API_URL=http://web2sms.skytel.mn/apiSend
# SMS_API_KEY=

# --- Утаснаас уншдаг оношилгоо ---
# Түлхүүргүй бол /recent, /orders, /errors, /check бүгд 404 буцаана.
# DEBUG_KEY=
